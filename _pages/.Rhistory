pacman::p_load(haven, psych, modelsummary, dplyr, kableExtra, ggplot2, estimatr)
wave_6 <- read_dta("data/amerispeak/Upenn_LongPoll_W6_20210601.dta")
library(pwr)
pwr.t.test(n = 500, sig.level = .05, power = .80, type = "two.sample")
library(pwr)
pwr.t.test(n = 250, sig.level = .05, power = .80, type = "two.sample")
library(pwr)
library(tidyverse)
sensitivity <- tibble(
n_dropped = c(0, 50, 100, 150, 200, 300)
) |>
mutate(
n_total = 1000 - n_dropped,
n_per_cell = n_total / 2,
d_detectable = map_dbl(n_per_cell, ~pwr.t.test(n = .x, sig.level = .05, power = .80, type = "two.sample")$d)
)
sensitivity
